# Copy to backend/.env. Every value is optional; these are the defaults.

# Postgres connection. Matches the database in docker-compose.yml.
DATABASE_URL=postgresql://creator:creator@localhost:5433/creator

# Browser origins allowed to call the API (regex). Defaults to localhost on any port.
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
